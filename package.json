{
  "type": "module",
  "name": "sd-carequeue",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "jest",
    "coverage": "jest --coverage",
    "coverage:appointments": "jest Staff_Webpages/Appointments.test.js --coverage --collectCoverageFrom=Staff_Webpages/Appointments.js",
    "coverage:booking": "jest Patients_WebPages/BookAppointments.test.js --coverage --collectCoverageFrom=Patients_WebPages/BookAppointments.js",
    "coverage:availability": "jest Staff_Webpages/Availability.test.js --coverage --collectCoverageFrom=Staff_Webpages/Availability.js",
    "coverage:dashboard": "jest Patients_WebPages/Dashboard.test.js --coverage --collectCoverageFrom=Patients_WebPages/Dashboard.js",
    "coverage:walkins": "jest Staff_Webpages/walkin.test.js --coverage --collectCoverageFrom=Staff_Webpages/walkin.js",
    "coverage:queue": "jest Staff_Webpages/Queues.test.js --coverage --collectCoverageFrom=Staff_Webpages/Queues.js"
  },
"jest": {
  "testEnvironment": "jsdom",
  "setupFiles": ["<rootDir>/jest.setup.js"],
  "collectCoverageFrom": [
    "Login/authLogic.js",
    "Admin_WebPages/staffLogic.js",
    "Patients_WebPages/*Logic.js",
    "Staff_Webpages/WalkinLogic.js",
    "Staff_Webpages/Appointments.js",
    "!**/*.test.js",
    "!**/node_modules/**"
  ]
},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NkadimengKgothatso/SD-CareQueue.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/NkadimengKgothatso/SD-CareQueue/issues"
  },
  "homepage": "https://github.com/NkadimengKgothatso/SD-CareQueue#readme",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1"
  },
  "dependencies": {
    "firebase": "^12.13.0"
  }
}
